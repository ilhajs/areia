{
  "name": "areia",
  "version": "0.1.28",
  "description": "Vanilla TS component library for building modern web applications",
  "keywords": [
    "components",
    "design-system",
    "ts",
    "ui",
    "vanilla"
  ],
  "license": "MIT",
  "author": "Ryuz <ryuzer@proton.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilhajs/areia.git"
  },
  "files": [
    "dist",
    "plugin.js",
    "tailwind.css"
  ],
  "type": "module",
  "browser": {
    "process": false
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./plugin.js": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "default": "./dist/plugin.js"
    },
    "./tailwind.css": "./tailwind.css"
  },
  "scripts": {
    "build": "tsc && tsdown",
    "test": "bun test"
  },
  "dependencies": {
    "@areia/slots": "0.1.5",
    "alien-signals": "3.2.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "lucide": "^1.18.0",
    "tailwindcss": "^4.3.1"
  },
  "peerDependencies": {
    "ilha": "^0.8.1",
    "sonner": "^2.0.7",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  }
}
