---
/**
 * Live demo + source card for MDX docs.
 *
 *   <Preview code={example}>
 *     <Demo client:load />
 *   </Preview>
 */
import { codeToHtml } from "shiki";

interface Props {
  code: string;
  lang?: string;
  codeOnly?: boolean;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  code,
  lang = "tsx",
  codeOnly = false,
  size = "md",
  class: className,
} = Astro.props;

const html = await codeToHtml(code, {
  lang: lang as any,
  themes: { light: "catppuccin-latte", dark: "catppuccin-mocha" },
});

const demoSize =
  size === "sm" ? "min-h-40 p-5" : size === "lg" ? "min-h-96 p-8" : "min-h-64 p-6";
---

<div
  class={`not-prose my-6 w-full overflow-hidden rounded-xl border border-border bg-background text-foreground shadow-xs ${className ?? ""}`}
>
  {
    !codeOnly && (
      <div class={`flex w-full flex-wrap items-center justify-center gap-3 ${demoSize}`}>
        <slot />
      </div>
    )
  }
  <div
    class="border-border border-t text-xs leading-relaxed [&_pre]:!m-0 [&_pre]:!rounded-none [&_pre]:!bg-transparent"
    set:html={html}
  />
</div>
