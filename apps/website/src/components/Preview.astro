---
/**
 * Live demo + source card for MDX docs.
 *
 *   <Preview code={example}>
 *     <Demo client:load />
 *   </Preview>
 */
import { Code } from "@/components/ui/code";
import { cn } from "@/lib/cn";

interface Props {
  code: string;
  lang?: string;
  codeOnly?: boolean;
  size?: "sm" | "md" | "lg";
  class?: string;
}

const {
  code,
  lang = "tsx",
  codeOnly = false,
  size = "md",
  class: className,
} = Astro.props;
---

<div
  class={cn(
    "not-prose my-6 w-full overflow-hidden rounded-xl border border-areia-border",
    "bg-areia-background text-areia-foreground shadow-xs",
    className,
  )}
>
  {
    !codeOnly && (
      <div
        class={cn(
          "flex w-full flex-wrap items-center justify-center gap-3",
          size === "sm" && "min-h-40 p-5",
          size === "md" && "min-h-64 p-6",
          size === "lg" && "min-h-96 p-8",
        )}
      >
        <slot />
      </div>
    )
  }
  <div class="areia-preview-code border-t border-areia-border">
    <Code code={code} lang={lang} />
  </div>
</div>

<style>
  /* Strip Nimbus code chrome — Preview already provides the card border. */
  .areia-preview-code :global(.nb-code-figure),
  .areia-preview-code :global(pre.astro-code) {
    margin: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .areia-preview-code :global(pre.astro-code) {
    font-size: 0.75rem;
    line-height: 1.625;
  }

  .areia-preview-code :global(.nb-code-figure[data-nb-lang]:not(.nb-code-figure-titled)::before) {
    display: none;
  }
</style>
