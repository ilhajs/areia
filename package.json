{
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "bun run --filter @areia/slots build && bun run --filter areia build && bun run --filter @areia/form build",
    "cleanup": "bun run --parallel --filter '*' cleanup && rimraf node_modules bun.lock",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "prepare": "husky",
    "test": "bun run --parallel --filter './packages/*' test",
    "docs:dev": "bun run --filter @areia/website dev",
    "docs:build": "bun run --filter @areia/website build",
    "docs:preview": "bun run --filter @areia/website preview"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.10.6",
    "@ilha/router": "^0.8.9",
    "@ilha/store": "^0.7.7",
    "@standard-schema/spec": "^1.1.0",
    "@types/bun": "^1.3.14",
    "areia": "workspace:*",
    "husky": "^9.1.7",
    "ilha": "0.10.3",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.3",
    "typescript": "^6.0.3",
    "unrun": "^0.3.1"
  }
}
