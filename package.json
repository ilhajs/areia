{
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "cleanup": "bun run --parallel --filter '*' cleanup && rimraf node_modules bun.lock",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "prepare": "husky",
    "test": "bun run --parallel --filter './packages/*' test",
    "docs:build": "rspress build",
    "docs:dev": "rspress dev",
    "docs:preview": "rspress preview"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@happy-dom/global-registrator": "^20.9.0",
    "@rspress/core": "^2.0.11",
    "@rspress/plugin-llms": "^2.0.13",
    "@rspress/plugin-preview": "^2.0.12",
    "@rspress/plugin-sitemap": "^2.0.13",
    "@rspress/plugin-twoslash": "^2.0.12",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.8.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "areia": "workspace:*",
    "husky": "^9.1.7",
    "ilha": "0.8.1",
    "lucide": "^1.16.0",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rimraf": "^6.1.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "unrun": "^0.3.0"
  }
}
